import discord
from discord.ext import commands
import datetime
import re

intents = discord.Intents.default()
intents.message_content = True
intents.members = True

bot = commands.Bot(command_prefix='!', intents=intents)

def parse_time(time_str):
    match = re.match(r"^(\d+)([smhd])$", time_str.lower())
    if not match:
        return None
    amount, unit = match.groups()
    amount = int(amount)
    if unit == 's': return datetime.timedelta(seconds=amount)
    elif unit == 'm': return datetime.timedelta(minutes=amount)
    elif unit == 'h': return datetime.timedelta(hours=amount)
    elif unit == 'd': return datetime.timedelta(days=amount)

@bot.event
async def on_ready():
    print(f'✅ تم تشغيل البوت بنجاح باسم: {bot.user}')

@bot.command(name="كتم")
@commands.has_permissions(moderate_members=True)
async def mute_cmd(ctx, member: discord.Member = None, time_str: str = "10m", *, reason="بدون سبب"):
    if not member:
        await ctx.send("❌ يرجى منشن الشخص! مثال: `!كتم @user 5m السبب`")
        return
    duration = parse_time(time_str)
    if not duration:
        await ctx.send("❌ صيغة الوقت غير صحيحة! استخدم مثلاً `5m` أو `2h` أو `1d`")
        return
    try:
        await member.timeout(duration, reason=reason)
        await ctx.send(f'🔇 تم كتم {member.mention} لمدة `{time_str}`.')
    except Exception as e:
        await ctx.send(f"❌ تعذر الكتم: {e}")

# ضع التوكن الخاص بك بين القوسين
bot.run('YOUR_DISCORD_BOT_TOKEN')
