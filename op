CloseButton.MouseButton1Click:Connect(function()
    for _, part in pairs(originalTracks) do
        if part and part:IsA("BasePart") then part.Transparency = 1 part.CanCollide = false end
    end
    for _, aura in pairs(originalAuras) do if aura then aura:Destroy() end end
    ScreenGui:Destroy()
end)

