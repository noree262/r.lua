TeleportToggle.MouseButton1Click:Connect(function()
    TeleportToggle.Text = "تلفيل خفي..."
    TeleportToggle.BackgroundColor3 = Color3.fromRGB(139, 128, 0)
    
    task.spawn(function()
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("TouchTransmitter") and (v.Parent.Name:lower():find("setup") or v.Parent.Name:lower():find("pc")) then
                pcall(function()
                    firetouchinterest(game.Players.LocalPlayer.Character.HumanoidRootPart, v.Parent, 0)
                    task.wait(0.2) -- تأخير آمن جداً يخدع الحماية
                    firetouchinterest(game.Players.LocalPlayer.Character.HumanoidRootPart, v.Parent, 1)
                end)
                task.wait(0.3) -- فاصة زمنية بين جهاز وجهاز لمنع الـ Kick
            end
        end
        TeleportToggle.Text = "تم بأمان! ✅"
        TeleportToggle.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
    end)
end)

