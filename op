-- [[ ⚡ زر الإيفنتات المحمي (يفعل فقط الريموتات الآمنة) ]]
local EventButton = Instance.new("TextButton", MainFrame)
EventButton.Position = UDim2.new(0.05, 0, 0.72, 0)
EventButton.Size = UDim2.new(0.9, 0, 0, 32)
EventButton.BackgroundColor3 = Color3.fromRGB(70, 30, 120)
EventButton.Text = "⚡ تشغيل إيفنتات الجوائز (فحص آمن)"
EventButton.TextColor3 = Color3.fromRGB(255, 255, 255)
EventButton.Font = Enum.Font.SourceSansBold
EventButton.TextSize = 13

EventButton.MouseButton1Click:Connect(function()
    EventButton.Text = "جاري الفحص الآمن... 🛡️"
    local rep = game:GetService("ReplicatedStorage")
    for _, child in pairs(rep:GetDescendants()) do
        if child:IsA("RemoteEvent") then
            local name = child.Name:lower()
            -- تشغيل فقط الريموتات التي تخص الجوائز والهدايا وتجنب ريموتات المطورين الحساسة
            if name:find("reward") or name:find("claim") or name:find("gift") or name:find("free") then
                pcall(function() child:FireServer() end)
                task.wait(0.1) -- حماية من الـ Spam
            end
        end
    end
    task.wait(0.5)
    EventButton.Text = "تم التنشيط الآمن! ✅"
end)

-- [[ مغير السرعة بنظام التخفي التام (Bypass Anti-Cheat) ]]
local SpeedSlider = Instance.new("TextBox", MainFrame)
SpeedSlider.Position = UDim2.new(0.05, 0, 0.85, 0)
SpeedSlider.Size = UDim2.new(0.9, 0, 0, 28)
SpeedSlider.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
SpeedSlider.PlaceholderText = "السرعة الآمنة (مثال: 60) واضغط إنتر 🏃"
SpeedSlider.Text = ""
SpeedSlider.TextColor3 = Color3.fromRGB(255, 255, 255)
SpeedSlider.Font = Enum.Font.SourceSansBold

local currentSpeed = 16
SpeedSlider.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local num = tonumber(SpeedSlider.Text)
        if num then 
            currentSpeed = num
        end
    end
end)

-- حلقة تكرار ذكية لتثبيت السرعة وتجنب فحص نظام الحماية للحركات المفاجئة
task.spawn(function()
    while true do
        pcall(function()
            local char = game.Players.LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") then
                if char.Humanoid.WalkSpeed ~= currentSpeed then
                    char.Humanoid.WalkSpeed = currentSpeed
                end
            end
        end)
        task.wait(0.1)
    end
end)
